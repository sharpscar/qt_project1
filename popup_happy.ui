      <string notr="true">QPushButton {
    color: #FFFFFF;
    border: none;
    border-radius: 20px;
    border-style: outset;
    background: qradialgradient(
        cx: 0.3, cy: -0.4, fx: 0.3, fy: -0.4,
        radius: 1.35, stop: 0 #DA3A7B, stop: 1 #DA3A7B
        );
    padding: 5px;
    }

QPushButton:pressed {
    border-style: inset;
    background: qradialgradient(
        cx: 0.4, cy: -0.1, fx: 0.4, fy: -0.1,
        radius: 1.35, stop: 0 #999, stop: 1 #999
        );
    }</string>
